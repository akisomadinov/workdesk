# Copy values into environment or a private .env in the repository root.
# Create the owner in local mode before enabling shared mode.
WORKDESK_SHARED_MODE=true
WORKDESK_ALLOWED_HOSTS=workdesk.example.org
WORKDESK_SOURCE_HOSTS=api.github.com,gitlab.example.org
# Exact IP of the reverse proxy if it is not on loopback.
WORKDESK_TRUSTED_PROXIES=172.20.0.10
